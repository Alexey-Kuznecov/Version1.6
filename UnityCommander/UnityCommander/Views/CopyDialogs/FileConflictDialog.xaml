<UserControl
    x:Class="UnityCommander.Views.CopyDialogs.FileConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Views.CopyDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        MinWidth="520"
        MaxWidth="700"
        Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{StaticResource UcForegroundSecondaryBrush}"
            Text="Файл уже существует" />

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,16"
            Foreground="{DynamicResource UcForegroundSecondaryBrush}"
            Text="Файл или папка с таким именем уже находится в папке назначения." />

        <!--  Источник  -->
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,4"
            FontWeight="SemiBold"
            Foreground="{StaticResource UcForegroundSecondaryBrush}"
            Text="Копируется:" />

        <Border
            Grid.Row="3"
            Margin="0,0,0,12"
            Padding="10"
            Background="{DynamicResource UcSurfaceTertiaryBrush}"
            BorderBrush="{DynamicResource UcBorderTertiaryBrush}"
            BorderThickness="1"
            CornerRadius="4">

            <TextBlock
                Foreground="{StaticResource UcForegroundSecondaryBrush}"
                Text="{Binding SourcePath}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <!--  Конфликтующий объект  -->
        <StackPanel Grid.Row="4">
            <TextBlock
                Margin="0,0,0,4"
                FontWeight="SemiBold"
                Foreground="{StaticResource UcForegroundSecondaryBrush}"
                Text="Конфликтующий объект:" />

            <Border
                Padding="10"
                Background="{DynamicResource UcSurfaceTertiaryBrush}"
                BorderBrush="{DynamicResource UcBorderTertiaryBrush}"
                BorderThickness="1"
                CornerRadius="4">

                <TextBlock
                    Foreground="{StaticResource UcForegroundSecondaryBrush}"
                    Text="{Binding DestinationPath}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!--  Кнопки  -->
        <Grid Grid.Row="5" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{Binding CancelCommand}"
                Content="Отмена"
                Style="{StaticResource ModernButton}" />

            <Button
                Grid.Column="1"
                Width="80"
                Height="30"
                Margin="8,0,0,0"
                Command="{Binding SkipCommand}"
                Content="Пропустить"
                Style="{StaticResource ModernButton}" />

            <Button
                Grid.Column="2"
                Width="80"
                Height="30"
                Margin="8,0,0,0"
                Command="{Binding SkipAllCommand}"
                Content="Пропустить все"
                Style="{StaticResource ModernButton}" />

            <Button
                Grid.Column="3"
                Width="80"
                Height="30"
                Margin="8,0,0,0"
                Command="{Binding ReplaceCommand}"
                Content="Заменить"
                Style="{StaticResource ModernButton}" />

            <Button
                Grid.Column="4"
                Width="80"
                Height="30"
                Margin="8,0,0,0"
                Command="{Binding ReplaceAllCommand}"
                Content="Заменить все"
                Style="{StaticResource ModernButton}" />

            <Button
                Grid.Column="5"
                Width="80"
                Height="30"
                Margin="8,0,0,0"
                Command="{Binding KeepBothCommand}"
                Content="Сохранить оба"
                Style="{StaticResource ModernButton}" />
        </Grid>
    </Grid>
</UserControl>
