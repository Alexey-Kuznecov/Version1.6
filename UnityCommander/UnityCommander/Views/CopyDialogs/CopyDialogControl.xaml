<UserControl
    x:Class="UnityCommander.Views.CopyDialogs.CopyDialogControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Width="450">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Label
                Margin="0"
                Content="Source:"
                FontSize="15"
                Foreground="{StaticResource UcForegroundSecondaryBrush}" />
            <TextBox
                Grid.Row="1"
                FontSize="14"
                Style="{DynamicResource UcTextBoxStyle}"
                Text="{Binding Source}" />
        </Grid>
        <Grid Grid.Row="1" Width="450">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Label
                Margin="0"
                Content="Destination:"
                FontSize="15"
                Foreground="{StaticResource UcForegroundSecondaryBrush}" />
            <TextBox
                Grid.Row="1"
                FontSize="14"
                Style="{DynamicResource UcTextBoxStyle}"
                Text="{Binding Target}" />
        </Grid>

        <WrapPanel Grid.Row="2" Margin="5">
            <Button
                Width="60"
                Height="30"
                Margin="10"
                Command="{Binding CopyCommand}"
                Content="Copy"
                Style="{StaticResource ModernButton}" />
            <Button
                Width="60"
                Height="30"
                Margin="10"
                Command="{Binding MoveCommand}"
                Content="Move"
                Style="{StaticResource ModernButton}" />
            <Button
                Width="60"
                Height="30"
                Margin="10"
                Command="{Binding CloseDialogCommand}"
                Content="Close"
                Style="{StaticResource ModernButton}" />
        </WrapPanel>
        <WrapPanel Grid.Row="3">
            <CheckBox
                Margin="2"
                Content="Копировать только содержимое папки"
                Foreground="{StaticResource UcForegroundSecondaryBrush}"
                IsChecked="{Binding CopyOnlyFolderContent}"
                Style="{DynamicResource UcCheckBoxStyle}" />
            <CheckBox
                Margin="2"
                Content="Закрыть окно полсе копирования"
                Foreground="{StaticResource UcForegroundSecondaryBrush}"
                IsChecked="{Binding CloseDialogAfterCopyingComplete}"
                Style="{DynamicResource UcCheckBoxStyle}" />
        </WrapPanel>
    </Grid>
</UserControl>
