<Window
    x:Class="UnityCommander.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:at="clr-namespace:UnityCommander.AttachProperties"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:controls="clr-namespace:UnityCommander.Controls.Window;assembly=UnityCommander.Controls"
    xmlns:conv="clr-namespace:UnityCommander.Converters"
    xmlns:core="clr-namespace:UnityCommander.Core;assembly=UnityCommander.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputBinding="clr-namespace:UnityCommander.WPF.Behaviors;assembly=UnityCommander.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notifications="clr-namespace:UnityCommander.Notifications.WPF.Views;assembly=UnityCommander.Notifications.WPF"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:UnityCommander.ViewModels"
    x:Name="Window"
    Title="Unity Commander"
    Width="1350"
    Height="800"
    controls:WindowControl.ViewModel="{Binding ImportCustomWindow, Mode=OneWayToSource}"
    controls:WindowControl.WindowInstance="{Binding ElementName=Window, Mode=OneWay}"
    d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Icon="{Binding Icon}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.FontFamily>
        <DynamicResource ResourceKey="MaterialDesignFont" />
    </Window.FontFamily>
    <Window.Background>
        <DynamicResource ResourceKey="MaterialDesignPaper" />
    </Window.Background>
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource UcForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource UcSurfaceTertiaryBrush}" />
            <Setter Property="Height" Value="50" />
        </Style>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />

        <Style x:Key="UcHorizontalGridSplitter" TargetType="{x:Type GridSplitter}">

            <Setter Property="Height" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ShowsPreview" Value="False" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Grid Background="{TemplateBinding Background}">

                            <!--  Subtle separator line  -->
                            <Border
                                x:Name="Separator"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource UcSurfaceSecondaryBrush}" />

                            <!--  Center grip  -->
                            <Border
                                x:Name="Grip"
                                Width="32"
                                Height="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource UcMenuItemForegroundBrush}"
                                CornerRadius="2"
                                Opacity="0.35" />

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Opacity" Value="1" />

                                <Setter TargetName="Grip" Property="Width" Value="40" />

                                <Setter TargetName="Separator" Property="Background" Value="{DynamicResource UcMenuItemForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid inputBinding:KeyboardBinding.Scope="MainWindow" Background="{DynamicResource UcApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="571*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!--  Ribbon  -->
            <RowDefinition Height="{Binding RibbonHeight}" />

            <!--  Notifications  -->
            <RowDefinition Height="Auto" />

            <!--  Main content  -->
            <RowDefinition Height="1*" MinHeight="250" />

            <!--  Bottom panel splitter  -->
            <RowDefinition Height="5" />

            <!--  Bottom panel  -->
            <RowDefinition
                Height="{Binding BottomHeight}"
                MinHeight="150"
                MaxHeight="550" />

            <!--  Status bar  -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <!--
            Toolbar region.
        -->

        <ContentControl
            Grid.Row="0"
            Grid.Column="3"
            Grid.ColumnSpan="3"
            prism:RegionManager.RegionName="{x:Static core:RegionNames.ToolBarRegion}" />


        <notifications:NotificationHost
            Grid.Row="1"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            DataContext="{Binding NotificationHost}" />

        <!--
            Functional selection region on the left side panel.
        -->
        <ContentControl
            Grid.Row="0"
            Grid.RowSpan="5"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            prism:RegionManager.RegionName="{x:Static core:RegionNames.LeftSideBarRegion}" />
        <!--
            File panel region.
        -->
        <Grid
            Grid.Row="2"
            Grid.Column="2"
            Grid.ColumnSpan="2">
            <DockingManager
                x:Name="DockManager"
                Grid.Row="1"
                AllowMixedOrientation="True"
                AutoWindowSizeWhenOpened="True"
                IsVirtualizingAnchorable="True"
                IsVirtualizingDocument="True" />
        </Grid>

        <GridSplitter
            Grid.Row="3"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Cursor="SizeNS"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            ShowsPreview="False"
            Style="{StaticResource UcHorizontalGridSplitter}" />

        <Border
            Grid.Row="4"
            Grid.Column="2"
            Grid.ColumnSpan="2">

            <ContentControl
                prism:RegionManager.RegionName="{x:Static core:RegionNames.BottomPanelRegion}"
                Background="{DynamicResource UcSurfaceSecondaryBrush}"
                Visibility="{Binding IsBottomPanelVisible, RelativeSource={RelativeSource AncestorType=Window}}" />

        </Border>

        <ContentControl
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            prism:RegionManager.RegionName="{x:Static core:RegionNames.StatusBarRegion}" />
    </Grid>
    <!--<WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="46"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="15" />
    </WindowChrome.WindowChrome>-->

</Window>