<UserControl
    x:Class="UnityCommander.WPF.Controls.PopupChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons;assembly=UnityCommander.Rendering"
    xmlns:local="clr-namespace:UnityCommander.WPF.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">
    <Border
        Background="{DynamicResource UcSurfaceTertiaryBrush}"
        BorderBrush="{DynamicResource UcBorderPrimaryBrush}"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0">
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Text="{Binding Title}" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <Button
                        Width="30"
                        Height="30"
                        Command="{Binding TogglePinCommand}"
                        Style="{DynamicResource UcButton}"
                        Visibility="{Binding IsPinnableVisibility}">

                        <icon:IconRender
                            Key="{Binding PinIconKey}"
                            Width="14"
                            Height="14"
                            Brush="{DynamicResource UcForegroundBrush}" />
                    </Button>

                    <Button
                        Width="30"
                        Height="30"
                        Command="{Binding CloseCommand}"
                        Style="{DynamicResource UcButton}">

                        <icon:IconRender
                            Key="Close"
                            Width="14"
                            Height="14"
                            Brush="{DynamicResource UcForegroundBrush}" />
                    </Button>

                </StackPanel>
            </Grid>

            <!--  Content  -->
            <ContentPresenter Grid.Row="1" Content="{Binding Content}" />
        </Grid>
    </Border>
</UserControl>
