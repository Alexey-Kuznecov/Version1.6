<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="IconDefaultBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="IconMutedBrush" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="IconDisabledBrush" Color="#FFB8B8B8" />

    <SolidColorBrush x:Key="IconAccentBrush" Color="#FF1976D2" />
    <SolidColorBrush x:Key="IconHoverBrush" Color="#FF1565C0" />
    <SolidColorBrush x:Key="IconSelectedBrush" Color="#FF0D47A1" />

    <SolidColorBrush x:Key="IconSuccessBrush" Color="#FF2E7D32" />
    <SolidColorBrush x:Key="IconWarningBrush" Color="#FFF9A825" />
    <SolidColorBrush x:Key="IconErrorBrush" Color="#FFC62828" />

    <SolidColorBrush x:Key="Theme.Accent" Color="Red" />
    <SolidColorBrush x:Key="Theme.Background" Color="Coral" />
    <SolidColorBrush x:Key="Theme.Foreground" Color="Black" />

    <SolidColorBrush x:Key="UcBackgroundPrimary" Color="{DynamicResource UcStateNormal}" />
    <SolidColorBrush x:Key="UcBackgroundHover" Color="{DynamicResource UcStateHover}" />
    <SolidColorBrush x:Key="UcBackgroundPressed" Color="{DynamicResource UcStatePressed}" />

    <SolidColorBrush x:Key="BorderDefault" Color="#D8ECFF" />
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#2B2B2B" />

    <SolidColorBrush x:Key="UcListView.BackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="UcListView.ForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="UcListView.BorderBrush" Color="#404040" />

    <SolidColorBrush x:Key="UcListViewItemBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="UcListViewItemForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="UcListViewItemBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="UcListViewItemHoverBrush" Color="#EDF3F0" />
    <SolidColorBrush x:Key="UcListViewItemSelectedBrush" Color="#D5DBD8" />
    <SolidColorBrush x:Key="UcListViewItemSelectedForegroundBrush" Color="White" />


</ResourceDictionary>