<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:overlay="clr-namespace:UnityCommander.UI.Overlay;assembly=UnityCommander.UI"
    xmlns:ui="clr-namespace:UnityCommander.UI.AttachProperties;assembly=UnityCommander.UI">

    <Style x:Key="UcGridItemTemplate" TargetType="{x:Type ListViewItem}">
        <Setter Property="ui:VisualElementRegistration.Model" Value="{Binding}" />
        <Setter Property="Template">

            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border
                        Background="{DynamicResource UcListViewItemBackgroundBrush}"
                        BorderBrush="{DynamicResource UcListViewItemBorderBrush}"
                        BorderThickness="0,1,0,1"
                        SnapsToDevicePixels="true">
                        <Border Name="InnerBorder">
                            <Grid Height="30">
                                <Rectangle
                                    Name="UpperHighlight"
                                    Fill="{DynamicResource UcListViewItemHoverBrush}"
                                    Visibility="Collapsed" />
                                <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="True" />
                                <overlay:OverlayHost x:Name="OverlayHost" />
                                <Border
                                    x:Name="CutOverlay"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource UcListViewItemBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCut}" Value="True">
                            <Setter TargetName="CutOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InnerBorder" Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="{DynamicResource UcListViewItemHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource UcListViewItemHoverBrush}" />
                            <Setter TargetName="UpperHighlight" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="InnerBorder" Property="Background" Value="{DynamicResource UcListViewItemSelectedBrush}" />
                            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{DynamicResource UcListViewItemSelectedBrush}" />
                            <!--<Setter TargetName="InnerBorder" Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />-->
                            <!--<Setter TargetName="UpperHighlight" Property="Visibility" Value="Visible" />
                            <Setter TargetName="UpperHighlight" Property="Fill" Value="{TemplateBinding BorderBrush}" />-->
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="true" />
                                <Condition Property="Selector.IsSelectionActive" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{DynamicResource UcListViewItemSelectedBrush}" />
                            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{DynamicResource UcListViewItemSelectedBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="true" />
                                <Condition Property="IsMouseOver" Value="true" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource UcListViewItemSelectedBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource UcListViewItemSelectedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>


                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UcListViewItemNormal" TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="{DynamicResource UcListViewBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UcListViewItemForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UcListViewBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">

                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource UcUcAccentHoverSecondaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource UcUcAccentSelectedSecondaryBrush}" />

                            <Setter Property="Foreground" Value="{DynamicResource UcListViewItemSelectedForegroundBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                </MultiTrigger.Conditions>

                <Setter Property="Background" Value="{DynamicResource UcListBoxItemSelectedBrush}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>

                <Setter Property="Background" Value="{DynamicResource UcListBoxBackgroundBrush}" />
            </MultiTrigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>