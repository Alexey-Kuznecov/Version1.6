<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Slider.Track" Color="#373839" />
    <SolidColorBrush x:Key="Slider.Track.Fill" Color="#D05A9E" />
    <SolidColorBrush x:Key="Slider.Thumb" Color="#2F3031" />
    <SolidColorBrush x:Key="Slider.Thumb.Border" Color="#D05A9E" />
    <SolidColorBrush x:Key="Slider.Thumb.Border.Hover" Color="#FFFFFF" />

    <Style x:Key="UcSliderStyle" TargetType="{x:Type Slider}">

        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Foreground" Value="{DynamicResource Slider.Track.Fill}" />

        <Setter Property="Background" Value="{DynamicResource Slider.Track}" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Slider}">

                    <Grid>

                        <Track x:Name="PART_Track">

                            <!--  Filled track  -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Background="{TemplateBinding Foreground}"
                                    BorderThickness="0"
                                    Command="{x:Static Slider.DecreaseLarge}"
                                    Focusable="False">

                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border
                                                Height="4"
                                                VerticalAlignment="Center"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>

                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <!--  Empty track  -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Command="{x:Static Slider.IncreaseLarge}"
                                    Focusable="False">

                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border
                                                Height="4"
                                                VerticalAlignment="Center"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>

                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <!--  Thumb  -->
                            <Track.Thumb>
                                <Thumb x:Name="Thumb">

                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">

                                            <Ellipse
                                                Width="12"
                                                Height="12"
                                                Fill="{DynamicResource Slider.Thumb}"
                                                Stroke="{DynamicResource Slider.Thumb.Border}"
                                                StrokeThickness="2" />

                                        </ControlTemplate>
                                    </Thumb.Template>

                                </Thumb>
                            </Track.Thumb>

                        </Track>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="14" />

                            <Setter TargetName="Thumb" Property="Height" Value="14" />

                            <Setter TargetName="Thumb" Property="ToolTip" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.4" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>