<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Geometry x:Key="ArrowUpGeometry2">
        M 0,4 L 3.5,0 L 7,4 Z
    </Geometry>

    <Geometry x:Key="ArrowDownGeometry2">
        M 0,0 L 3.5,4 L 7,0 Z
    </Geometry>

    <Style x:Key="ModernVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">

        <Setter Property="Width" Value="14" />
        <Setter Property="Background" Value="{DynamicResource UcSurfaceSecondaryBrush}" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ScrollBar">

                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>
                        <RepeatButton
                            Grid.Row="0"
                            Width="12"
                            Height="12"
                            Background="{x:Null}"
                            Command="ScrollBar.LineUpCommand">
                            <Path
                                Width="8"
                                Height="8"
                                Data="{StaticResource ArrowUpGeometry2}"
                                Fill="{DynamicResource UcForegroundPrimaryBrush}" />
                        </RepeatButton>

                        <Track
                            x:Name="PART_Track"
                            Grid.Row="1"
                            IsDirectionReversed="True">

                            <!--  Ползунок  -->
                            <Track.Thumb>
                                <Thumb>

                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">

                                            <Border
                                                Margin="2"
                                                Background="{DynamicResource UcListViewThumbBackgroundBrush}"
                                                CornerRadius="3" />

                                        </ControlTemplate>
                                    </Thumb.Template>

                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <RepeatButton
                            Grid.Row="2"
                            Width="12"
                            Height="12"
                            Background="{x:Null}"
                            Command="ScrollBar.LineDownCommand">
                            <Path
                                Width="10"
                                Height="10"
                                Data="{StaticResource ArrowDownGeometry2}"
                                Fill="{DynamicResource UcForegroundPrimaryBrush}" />
                        </RepeatButton>
                    </Grid>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="ArrowLeftGeometry">
        M 6,0 L 0,5 L 6,10 Z
    </Geometry>

    <Geometry x:Key="ArrowRightGeometry">
        M 0,0 L 6,5 L 0,10 Z
    </Geometry>

    <Style x:Key="ModernHorizontalScrollBarStyle" TargetType="{x:Type ScrollBar}">

        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="{DynamicResource UcSurfaceSecondaryBrush}" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ScrollBar">

                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>
                        <RepeatButton
                            Grid.Column="0"
                            Width="12"
                            Height="12"
                            Background="{x:Null}"
                            Command="ScrollBar.LineLeftCommand">

                            <Path
                                Width="8"
                                Height="8"
                                Data="{StaticResource ArrowLeftGeometry}"
                                Fill="{DynamicResource UcForegroundPrimaryBrush}" />

                        </RepeatButton>

                        <Track
                            x:Name="PART_Track"
                            Grid.Column="1"
                            IsDirectionReversed="False"
                            Orientation="Horizontal">

                            <!--  Ползунок  -->
                            <Track.Thumb>
                                <Thumb>

                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">

                                            <Border
                                                Margin="2"
                                                Background="{DynamicResource UcListViewThumbBackgroundBrush}"
                                                CornerRadius="3" />

                                        </ControlTemplate>
                                    </Thumb.Template>

                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <RepeatButton
                            Grid.Column="2"
                            Width="12"
                            Height="12"
                            Background="{x:Null}"
                            Command="ScrollBar.LineRightCommand">

                            <Path
                                Width="8"
                                Height="8"
                                Data="{StaticResource ArrowRightGeometry}"
                                Fill="{DynamicResource UcForegroundPrimaryBrush}" />
                        </RepeatButton>
                    </Grid>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{DynamicResource UcSurfacePrimaryBrush}" SnapsToDevicePixels="true">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="{TemplateBinding Padding}">

                            <ScrollViewer
                                DockPanel.Dock="Top"
                                Focusable="false"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden">

                                <GridViewHeaderRowPresenter
                                    Margin="2,0,2,0"
                                    AllowsColumnReorder="{Binding Path=TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContainerStyle="{Binding Path=TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContextMenu="{Binding Path=TemplatedParent.View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderStringFormat="{Binding Path=TemplatedParent.View.ColumnHeaderStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderTemplate="{Binding Path=TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderTemplateSelector="{Binding Path=TemplatedParent.View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderToolTip="{Binding Path=TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                    Columns="{Binding Path=TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>

                            <ScrollContentPresenter
                                Name="PART_ScrollContentPresenter"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                KeyboardNavigation.DirectionalNavigation="Local"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </DockPanel>

                        <ScrollBar
                            Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Background="{DynamicResource UcSurfaceTertiaryBrush}"
                            BorderBrush="{DynamicResource UcSurfaceSecondaryBrush}"
                            Cursor="Arrow"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0.0"
                            Orientation="Horizontal"
                            Style="{StaticResource ModernHorizontalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <ScrollBar
                            Name="PART_VerticalScrollBar"
                            Grid.Column="1"
                            Background="{DynamicResource UcSurfaceTertiaryBrush}"
                            BorderBrush="{DynamicResource UcSurfaceSecondaryBrush}"
                            Cursor="Arrow"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0.0"
                            Orientation="Vertical"
                            Style="{StaticResource ModernVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <DockPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{Binding Path=Background, ElementName=PART_VerticalScrollBar}"
                            LastChildFill="false">
                            <Rectangle
                                Width="1"
                                DockPanel.Dock="Left"
                                Fill="{DynamicResource UcSurfaceTertiaryBrush}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <Rectangle
                                Height="1"
                                DockPanel.Dock="Top"
                                Fill="{DynamicResource UcSurfaceTertiaryBrush}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="UcScrollViewerStyle" TargetType="{x:Type ScrollViewer}">

        <Setter Property="Focusable" Value="True" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ScrollViewer}">

                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <!--  Контент  -->
                        <ScrollContentPresenter
                            Name="PART_ScrollContentPresenter"
                            Grid.Row="0"
                            Grid.Column="0"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            KeyboardNavigation.DirectionalNavigation="Local"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />


                        <!--  Horizontal ScrollBar  -->
                        <ScrollBar
                            Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Grid.Column="0"
                            Background="{DynamicResource UcSurfaceTertiaryBrush}"
                            BorderBrush="{DynamicResource UcSurfaceSecondaryBrush}"
                            Cursor="Arrow"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0.0"
                            Orientation="Horizontal"
                            Style="{StaticResource ModernHorizontalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />


                        <!--  Vertical ScrollBar  -->
                        <ScrollBar
                            Name="PART_VerticalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="{DynamicResource UcSurfaceTertiaryBrush}"
                            BorderBrush="{DynamicResource UcSurfaceSecondaryBrush}"
                            Cursor="Arrow"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0.0"
                            Orientation="Vertical"
                            Style="{StaticResource ModernVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />


                        <!--  Угол между scrollbar  -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{DynamicResource UcSurfaceTertiaryBrush}" />

                    </Grid>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>