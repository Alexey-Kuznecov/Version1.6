<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:UnityCommander.UI.Interaction;assembly=UnityCommander.UI"
    xmlns:widget="clr-namespace:UnityCommander.WPF.Widget;assembly=UnityCommander.WPF"
    xmlns:wpf="clr-namespace:UnityCommander.WPF.Converters;assembly=UnityCommander.WPF">

    <Style TargetType="{x:Type widget:WidgetHost}">

        <Setter Property="Background" Value="{DynamicResource UcSurfaceSecondaryBrush}" />

        <Setter Property="BorderBrush" Value="{DynamicResource UcBorderPrimaryBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widget:WidgetHost}">


                    <ItemsPresenter Grid.Row="1" />

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>