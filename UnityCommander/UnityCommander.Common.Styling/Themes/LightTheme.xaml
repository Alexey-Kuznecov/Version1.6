<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="UcDarkColor">#F5F6F7</Color>
    <Color x:Key="UcSurfaceColor">#FFFFFF</Color>
    <Color x:Key="UcLightSurfaceColor">#EEF0F2</Color>
    <Color x:Key="UcGrayColor">#4A4D50</Color>
    <Color x:Key="UcMutedGrayColor">#74787C</Color>
    <Color x:Key="UcLightGrayColor">#A7ABB0</Color>
    <Color x:Key="UcBlackColor">#161719</Color>
    <Color x:Key="UcSelectionColor">#DCE8F8</Color>
    <Color x:Key="UcFocusColor">#D8ECFF</Color>
    <Color x:Key="UcBorderColor">#D4D7DA</Color>
    <Color x:Key="UcBlueColor">#576C95</Color>
    <Color x:Key="UcPinkColor">#E83E83</Color>


    <SolidColorBrush x:Key="UcApplicationBackgroundBrush" Color="#E3E4E5" />

    <SolidColorBrush x:Key="UcForegroundPrimaryBrush" Color="{StaticResource UcGrayColor}" />

    <SolidColorBrush x:Key="UcForegroundSecondaryBrush" Color="{StaticResource UcMutedGrayColor}" />

    <SolidColorBrush x:Key="UcForegroundTertiaryBrush" Color="{StaticResource UcMutedGrayColor}" />

    <SolidColorBrush x:Key="UcForegroundDisabledBrush" Color="{StaticResource UcLightGrayColor}" />

    <SolidColorBrush x:Key="UcForegroundSelectionBrush" Color="{StaticResource UcBlackColor}" />

    <SolidColorBrush x:Key="UcSurfacePrimaryBrush" Color="White" />

    <SolidColorBrush x:Key="UcSurfaceSecondaryBrush" Color="{StaticResource UcSurfaceColor}" />

    <SolidColorBrush x:Key="UcSurfaceTertiaryBrush" Color="{StaticResource UcLightSurfaceColor}" />

    <SolidColorBrush x:Key="UcHoverPrimaryBrush" Color="{DynamicResource UcLightSurfaceColor}" />

    <SolidColorBrush x:Key="UcHoverSecondaryBrush" Color="#E6E8EA" />

    <SolidColorBrush x:Key="UcHoverTertiaryBrush" Color="#E0E3E5" />

    <SolidColorBrush x:Key="UcPressedBrush" Color="#E1E3E5" />

    <SolidColorBrush x:Key="UcSelectionPrimaryBrush" Color="{StaticResource UcSelectionColor}" />

    <SolidColorBrush x:Key="UcSelectionSecondaryBrush" Color="{StaticResource UcMutedGrayColor}" />

    <SolidColorBrush x:Key="UcSelectionTertiaryBrush" Color="{StaticResource UcGrayColor}" />

    <SolidColorBrush x:Key="UcFocusBrush" Color="{StaticResource UcBlueColor}" />

    <SolidColorBrush x:Key="UcBorderPrimaryBrush" Color="{StaticResource UcBorderColor}" />

    <SolidColorBrush x:Key="UcBorderSecondaryBrush" Color="#E1E3E5" />

    <SolidColorBrush x:Key="UcBorderTertiaryBrush" Color="#C5C9CD" />

    <SolidColorBrush x:Key="UcAccentPrimaryBrush" Color="#3582FF" />

    <SolidColorBrush x:Key="UcAccentSecondaryBrush" Color="{StaticResource UcBlueColor}" />

    <SolidColorBrush x:Key="UcAccentTertiaryBrush" Color="{StaticResource UcPinkColor}" />


    <SolidColorBrush x:Key="UcUcAccentHoverSecondaryBrush" Color="#6077A5" />
    <SolidColorBrush x:Key="UcUcAccentSelectedSecondaryBrush" Color="#4F6388" />


    <!--  Titlebar Brushes  -->
    <Color x:Key="UcTitleBarShadowColor">#D8ECFF</Color>
    <Color x:Key="UcTitleBarCenterShadowColor">#191A1B</Color>

    <!--  Special Brushes  -->

    <SolidColorBrush x:Key="UcSuccessBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="UcWarningBrush" Color="#F9A825" />

    <SolidColorBrush x:Key="UcErrorBackgroundBrush" Color="#FFD5F2" />
    <SolidColorBrush x:Key="UcErrorBorderBrush" Color="#FFCAEE" />
    <SolidColorBrush x:Key="UcErrorForegroundBrush" Color="#D979BB" />

    <SolidColorBrush x:Key="UcInformationBrush" Color="#1565C0" />

    <SolidColorBrush x:Key="UcListViewBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="UcListViewForegroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="UcListViewBorderBrush" Color="#E6E6EA" />

    <SolidColorBrush x:Key="UcListBoxBackgroundBrush" Color="#E6E6EA" />
    <SolidColorBrush x:Key="UcListBoxForegroundBrush" Color="#808082" />
    <SolidColorBrush x:Key="UcListBoxBorderBrush" Color="#E6E6EA" />

    <SolidColorBrush x:Key="UcListViewThumbBackgroundBrush" Color="#808082" />
    <SolidColorBrush x:Key="UcListViewItemBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="UcListViewItemForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="UcListViewItemBorderBrush" Color="#E6E6EA" />

    <SolidColorBrush x:Key="UcListBoxItemBackgroundBrush" Color="#FDFEFF" />
    <SolidColorBrush x:Key="UcListBoxItemForegroundBrush" Color="#FDFEFF" />
    <SolidColorBrush x:Key="UcListBoxItemBorderBrush" Color="#E6E6EA" />

    <SolidColorBrush x:Key="UcListViewItemHoverBrush" Color="#EEEEF2" />
    <SolidColorBrush x:Key="UcListViewItemSelectedBrush" Color="#F3F3F7" />
    <SolidColorBrush x:Key="UcListViewItemSelectedForegroundBrush" Color="#E6E6EA" />

    <SolidColorBrush x:Key="UcListBoxItemHoverBrush" Color="#E6E6EA" />
    <SolidColorBrush x:Key="UcListBoxItemSelectedBrush" Color="#E6E6EA" />
    <SolidColorBrush x:Key="UcListBoxItemSelectedForegroundBrush" Color="#E6E6EA" />

    <SolidColorBrush x:Key="UcMenuItemHoverBrush" Color="#2B2C2D" />
    <SolidColorBrush x:Key="UcMenuItemBackgroundBrush" Color="#2B2C2D" />
    <SolidColorBrush x:Key="UcMenuItemForegroundBrush" Color="#808082" />
    <SolidColorBrush x:Key="UcMenuItemBorderBrush" Color="#202020" />

    <SolidColorBrush x:Key="UcMenuHoverBrush" Color="#2B2C2D" />
    <SolidColorBrush x:Key="UcMenuBackgroundBrush" Color="#373839" />
    <SolidColorBrush x:Key="UcMenuForegroundBrush" Color="#2B2C2D" />
    <SolidColorBrush x:Key="UcMenuBorderBrush" Color="#202020" />

    <SolidColorBrush x:Key="UcSeparatorBrush" Color="#202020" />

    <!--  WINDOWS CHROME  -->

    <SolidColorBrush x:Key="UcWindowChromeForegroundBrush" Color="#373839" />
    <SolidColorBrush x:Key="UcWindowChromeBorderBrush" Color="#373839" />


    <!--  SIDEBAR  -->

    <!--<SolidColorBrush x:Key="UcSideBarItemSelectedBrush" Color="#4F6388" />
    <SolidColorBrush x:Key="UcSideBarItemHoverBrush" Color="#5C719D" />-->

    <!--  STATUS BAR  -->

    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#808082" />
    <SolidColorBrush x:Key="StatusBarTrackBrush" Color="White" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#ABABAB" />

</ResourceDictionary>