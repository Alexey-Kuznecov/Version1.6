<UserControl
    x:Class="UnityCommander.Modules.FilePanel.Controls.RenameOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:be="clr-namespace:UnityCommander.WPF.Behaviors;assembly=UnityCommander.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.FilePanel.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource UcSurfaceTertiaryBrush}"
        IsHitTestVisible="True">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox
            x:Name="NameTextBox"
            Grid.Column="0"
            Height="30"
            Margin="1,0"
            Padding="4,6"
            VerticalAlignment="Center"
            be:InputCaptureBehavior.IsEnabled="True"
            Background="{DynamicResource UcSurfaceTertiaryBrush}"
            BorderBrush="{DynamicResource UcBorderPrimaryBrush}"
            BorderThickness="0"
            FontSize="12"
            Foreground="{DynamicResource UcForegroundTertiaryBrush}" />

        <Button
            Grid.Column="1"
            Width="80"
            Height="30"
            Padding="8,0"
            Click="OnApply"
            Content="Применить"
            Style="{DynamicResource ModernButton}" />

        <Button
            Grid.Column="2"
            Width="80"
            Height="30"
            Padding="8,0"
            Click="OnCancel"
            Content="Отмена"
            Style="{DynamicResource ModernButton}" />

    </Grid>
</UserControl>
