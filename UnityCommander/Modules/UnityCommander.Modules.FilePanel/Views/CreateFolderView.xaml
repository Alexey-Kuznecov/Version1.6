<UserControl
    x:Class="UnityCommander.Modules.FilePanel.Views.CreateFolderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.FilePanel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border
        Width="280"
        Padding="16"
        Background="{DynamicResource UcSurfaceTertiaryBrush}"
        CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                Text="Create Folder" />
            <TextBox
                Grid.Row="1"
                Height="32"
                Padding="4,6"
                Background="{DynamicResource UcSurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource UcBorderPrimaryBrush}"
                Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel
                Grid.Row="2"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Command="{Binding CreateCommand}"
                    Content="Create"
                    Style="{DynamicResource ModernButton}" />
                <Button
                    MinWidth="120"
                    Command="{Binding CreateAndOpenCommand}"
                    Content="Create &amp; Open"
                    Style="{DynamicResource ModernButton}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
