<UserControl
    x:Class="UnityCommander.Modules.FilePanel.Dialog.CreationDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.FilePanel.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,6"
            Text="Тип" />

        <ComboBox
            Grid.Row="1"
            SelectedValue="{Binding Type}"
            SelectedValuePath="Tag">
            <ComboBoxItem Content="Файл" Tag="File" />

            <ComboBoxItem Content="Папка" Tag="Directory" />
        </ComboBox>

        <TextBlock
            Grid.Row="2"
            Margin="0,12,0,6"
            Text="Имя" />

        <TextBox
            Grid.Row="3"
            MinWidth="300"
            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Grid
            Grid.Row="4"
            Margin="0,12,0,0"
            Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,6"
                Text="Расширение" />

            <ComboBox
                Grid.Row="1"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Extensions}"
                SelectedItem="{Binding SelectedExtension}" />
        </Grid>

        <StackPanel
            Grid.Row="5"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding CancelCommand}"
                Content="Отмена" />

            <Button
                Width="80"
                Command="{Binding AcceptCommand}"
                Content="Создать" />
        </StackPanel>
    </Grid>
</UserControl>
