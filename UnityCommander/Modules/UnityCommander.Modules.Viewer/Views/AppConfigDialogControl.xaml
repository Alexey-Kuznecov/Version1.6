<UserControl
    x:Class="UnityCommander.Modules.Viewer.Views.AppConfigDialogControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.Viewer.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="600"
    MinWidth="800"
    d:MaxHeight="450"
    d:MaxWidth="800"
    d:MinHeight="450"
    mc:Ignorable="d">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <TextBlock
            Margin="0,0,0,10"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Настройки" />

        <!--  Поиск  -->
        <TextBox
            Grid.Row="1"
            Height="30"
            Margin="0,0,0,10" />

        <!--  Основная область  -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Навигация  -->
            <Border Grid.Column="0" Margin="0,0,10,0">

                <ListBox BorderThickness="0">

                    <ListBoxItem>⚙ Общие</ListBoxItem>
                    <ListBoxItem>🎨 Интерфейс</ListBoxItem>
                    <ListBoxItem>📁 Файлы</ListBoxItem>
                    <ListBoxItem>🖥 Панели</ListBoxItem>
                    <ListBoxItem>🔌 Плагины</ListBoxItem>

                </ListBox>

            </Border>

            <!--  Контент  -->
            <Border
                Grid.Column="1"
                Padding="16"
                BorderBrush="#404040"
                BorderThickness="1">

                <ContentControl />

            </Border>

        </Grid>

        <!--  Кнопки  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button Width="90" Content="ОК" />
            <Button
                Width="90"
                Margin="5,0,0,0"
                Content="Отмена" />
            <Button
                Width="90"
                Margin="5,0,0,0"
                Content="Применить" />

        </StackPanel>

    </Grid>
</UserControl>
