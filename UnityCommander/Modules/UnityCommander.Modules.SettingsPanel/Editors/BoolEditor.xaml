<UserControl
    x:Class="UnityCommander.Modules.SettingsPanel.Editors.BoolEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.SettingsPanel.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style BasedOn="{StaticResource UcToggleButton}" TargetType="ToggleButton">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="5">
        <Border
            Grid.Column="0"
            Height="100"
            Padding="1"
            BorderThickness="1"
            CornerRadius="4">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource UcBorderPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />

                    <Style.Triggers>

                        <!--  Hover  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource UcHoverSecondaryBrush}" />
                        </Trigger>
                        
                    </Style.Triggers>
                </Style>
            </Border.Style>


            <Grid Margin="20,15,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{StaticResource UcForegroundTertiaryBrush}"
                    Text="{Binding DisplayName}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="{StaticResource UcForegroundTertiaryBrush}"
                    Text="{Binding Description}" />
                <ToggleButton
                    Grid.RowSpan="1"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Value}"
                    Style="{StaticResource UcToggleButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
