<UserControl
    x:Class="UnityCommander.Modules.SettingsPanel.Editors.BoolEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.SettingsPanel.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style BasedOn="{StaticResource UcToggleButton}" TargetType="ToggleButton">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="5">
        <Border
            Grid.Column="0"
            Height="100"
            Padding="1"
            BorderThickness="1"
            CornerRadius="4">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource UcBorderPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />

                    <Style.Triggers>

                        <!--  Hover  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource UcHoverTertiaryBrush}" />
                            <Setter Property="Background" Value="{StaticResource UcHoverTertiaryBrush}" />
                        </Trigger>

                    </Style.Triggers>
                </Style>
            </Border.Style>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Название + описание  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,24,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource UcForegroundPrimaryBrush}"
                        Text="{Binding DisplayName}" />

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />

                </StackPanel>

                <!--  Контрол  -->
                <ToggleButton
                    Grid.Column="1"
                    Width="42"
                    Height="23"
                    Margin="0,0,30,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Value}"
                    Style="{StaticResource UcToggleButton2}" />

            </Grid>

        </Border>
    </Grid>
</UserControl>
