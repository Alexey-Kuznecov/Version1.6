<UserControl
    x:Class="UnityCommander.Modules.SettingsPanel.Views.SettingsPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons;assembly=UnityCommander.Rendering"
    xmlns:inputBinding="clr-namespace:UnityCommander.WPF.Behaviors;assembly=UnityCommander.WPF"
    xmlns:local="clr-namespace:UnityCommander.Modules.SettingsPanel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>

        <SolidColorBrush x:Key="NavBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="NavBorder" Color="#E4E4E4" />
        <SolidColorBrush x:Key="NavHover" Color="#EFEFEF" />
        <SolidColorBrush x:Key="NavSelected" Color="#D8E8FF" />
        <SolidColorBrush x:Key="NavSelectedBorder" Color="#4A90E2" />

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource NavBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">

            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border
                            x:Name="Border"
                            Margin="6,2"
                            Padding="10,8"
                            Background="Transparent"
                            CornerRadius="6">

                            <ContentPresenter />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource NavHover}" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource NavSelected}" />

                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource NavSelectedBorder}" />

                                <Setter TargetName="Border" Property="BorderThickness" Value="3,0,0,0" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid inputBinding:KeyboardBinding.Scope="Dialog">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="Indicator"
            Width="3"
            HorizontalAlignment="Left"
            Background="Transparent" />

        <Border
            x:Name="Background"
            Margin="3,0,0,0"
            Padding="12,8">

            <ContentPresenter />

        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <Grid
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Cursor="Hand">
                                    <icon:IconRender
                                        Key="git"
                                        Width="15"
                                        Height="15" />
                                </Grid>

                                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />

                            </StackPanel>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>
            </ListBox>

        </Border>

        <ItemsControl
            Grid.Row="1"
            Grid.Column="1"
            ItemsSource="{Binding SelectedPage.Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding Editor}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
