<UserControl
    x:Class="UnityCommander.Modules.LeftSideBars.Content.PluginControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons;assembly=UnityCommander.Rendering"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:UnityCommander.Modules.LeftSideBars.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:PluginPanelViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="UcPluginListBoxItemStyle" TargetType="{x:Type ListBoxItem}">

            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">

                        <Border
                            x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <!--  Hover  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource UcSurfaceSecondaryBrush}" />
                            </Trigger>

                            <!--  Selected  -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource UcSurfaceTertiaryBrush}" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <TextBlock
            Grid.Row="0"
            Margin="16,0"
            VerticalAlignment="Center"
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{DynamicResource UcForegroundPrimaryBrush}"
            Text="Plugins" />

        <!--  Список  -->
        <ListBox
            Grid.Row="1"
            Margin="8,0"
            ItemContainerStyle="{StaticResource UcPluginListBoxItemStyle}"
            ItemsSource="{Binding PluginDescriptors}"
            SelectedItem="{Binding SelectedDescriptor}"
            Style="{StaticResource UcListBoxTemplate}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="4,3"
                        Padding="14,10"
                        Background="Transparent"
                        CornerRadius="6">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Информация о плагине  -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">

                                <!--  Название + версия  -->
                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource UcForegroundPrimaryBrush}"
                                        Text="{Binding DisplayName}" />

                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource UcSurfaceTertiaryBrush}"
                                        CornerRadius="3">

                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                                            Text="{Binding Version}" />
                                    </Border>

                                </StackPanel>

                                <!--  Описание  -->
                                <TextBlock
                                    MaxHeight="36"
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                                    Text="{Binding Description}"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <!--  Настройки  -->
                            <Border
                                Grid.Column="1"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource UcSurfaceTertiaryBrush}"
                                CornerRadius="5"
                                Style="{StaticResource IconHostStyle}">

                                <icon:IconRender
                                    Key="Cog"
                                    Width="17"
                                    Height="17"
                                    Brush="{DynamicResource UcForegroundSecondaryBrush}"
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.OpenSettingDialogCommand}"
                                    CommandParameter="{Binding}" />

                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
