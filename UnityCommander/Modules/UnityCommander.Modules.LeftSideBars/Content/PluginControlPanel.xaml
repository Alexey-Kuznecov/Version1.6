<UserControl
    x:Class="UnityCommander.Modules.LeftSideBars.Content.PluginControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:UnityCommander.Integration.Converters;assembly=UnityCommander.Integration"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons;assembly=UnityCommander.Rendering"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:UnityCommander.Modules.LeftSideBars.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:PluginPanelViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converter:OptionRenderConverter x:Key="OptionRenderConverter" />
        <converter:OptionRenderSelector x:Key="OptionRenderSelector" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="250" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Width="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="20"
            Text="Plugins" />
        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding PluginDescriptors}"
            SelectedItem="{Binding SelectedDescriptor}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Заголовок  -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Orientation="Horizontal">

                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}" />

                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="Gray"
                                Text="{Binding Version}" />
                        </StackPanel>

                        <!--  Описание  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            MaxHeight="42"
                            Margin="0,4,0,0"
                            Text="{Binding Description}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />

                        <!--  Кнопка  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Height="25"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconHostStyle}">
                            <icon:IconRender
                                Key="Cog"
                                Width="20"
                                Height="20"
                                Brush="DarkSlateGray"
                                Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.OpenSettingDialogCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}, Path=SelectedItem}" />


                        </Border>

                        <!--<ContentControl
                            Grid.Row="0"
                            Grid.Column="1"
                            Height="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Content="{Binding Icon.Path.Data}"
                            Foreground="Red"
                            Style="{DynamicResource CustomButtonStyles}"
                            Template="{DynamicResource CustomButtonTemplate}">

                            <ContentControl.InputBindings>
                                <MouseBinding
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.OpenSettingDialogCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}, Path=SelectedItem}"
                                    Gesture="LeftClick" />
                            </ContentControl.InputBindings>

                        </ContentControl>-->
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock
            Grid.Row="2"
            Width="250"
            Height="35"
            Padding="10,10,10,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Gainsboro"
            FontSize="16"
            FontWeight="Medium"
            Text="Plugin settings" />
        <StackPanel Grid.Row="3">
            <ItemsControl
                Margin="10"
                ItemTemplateSelector="{StaticResource OptionRenderSelector}"
                ItemsSource="{Binding OptionRender}" />
        </StackPanel>
    </Grid>
</UserControl>
