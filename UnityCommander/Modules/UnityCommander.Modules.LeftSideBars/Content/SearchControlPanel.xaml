<UserControl
    x:Class="UnityCommander.Modules.LeftSideBars.Content.SearchControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:be="clr-namespace:UnityCommander.WPF.Behaviors;assembly=UnityCommander.WPF"
    xmlns:control="clr-namespace:UnityCommander.Modules.LeftSideBars.Controls"
    xmlns:ctl="clr-namespace:UnityCommander.WPF.Controls;assembly=UnityCommander.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.LeftSideBars.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:UnityCommander.Modules.LeftSideBars.Models"
    xmlns:result="clr-namespace:UnityCommander.Modules.LeftSideBars.Search"
    xmlns:wpf="clr-namespace:UnityCommander.WPF.Converters;assembly=UnityCommander.WPF"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <wpf:DataSizeConverter x:Key="DataSizeConverter" />
    </UserControl.Resources>

    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--  Search  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Search field  -->

            <ctl:SearchTextBox
                Grid.Row="0"
                Height="32"
                VerticalContentAlignment="Center"
                be:InputCaptureBehavior.IsEnabled="True"
                Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                Placeholder="{Binding SearchPlaceholder}"
                Style="{StaticResource UcTextBoxSearchStyle}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </ctl:SearchTextBox>

            <!--<TextBox
                Grid.Row="0"
                Height="32"
                Padding="8,0"
                VerticalContentAlignment="Center"
                be:InputCaptureBehavior.IsEnabled="True"
                Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                Style="{StaticResource UcTextBoxStyle}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">

                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>

            </TextBox>-->

            <!--  Basic options  -->
            <Grid Grid.Row="1" Margin="0,8,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Search mode  -->
                <ComboBox
                    Grid.Column="0"
                    Height="28"
                    Margin="0,0,6,0"
                    ItemContainerStyle="{StaticResource UcComboBoxItemStyle}"
                    SelectedValue="{Binding SearchMode}"
                    SelectedValuePath="Tag"
                    Style="{StaticResource UcComboBoxStyle}">

                    <ComboBoxItem Content="Contains" Tag="{x:Static model:SearchMatcherMode.Contains}" />

                    <ComboBoxItem Content="Starts with" Tag="{x:Static model:SearchMatcherMode.StartsWith}" />

                    <ComboBoxItem Content="Mask" Tag="{x:Static model:SearchMatcherMode.Mask}" />

                    <ComboBoxItem Content="Regular expression" Tag="{x:Static model:SearchMatcherMode.Regex}" />

                </ComboBox>

                <!--  Case sensitive  -->
                <CheckBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Aa"
                    Foreground="{StaticResource UcForegroundTertiaryBrush}"
                    IsChecked="{Binding IsCaseSensitive}"
                    Style="{StaticResource UcCheckBoxStyle}" />

            </Grid>

        </Grid>


        <!--  Additional options  -->
        <Expander
            Grid.Row="1"
            Margin="0,0,0,10"
            Foreground="{DynamicResource UcForegroundSecondaryBrush}"
            Header="Additional options"
            Style="{StaticResource UcExpanderStyle}">

            <Grid Margin="0,8,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!--  Search scope  -->
                <Grid Grid.Row="0" Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Search in" />

                    <ComboBox
                        Grid.Column="1"
                        Height="28"
                        ItemContainerStyle="{StaticResource UcComboBoxItemStyle}"
                        SelectedValue="{Binding SearchScopeMode}"
                        SelectedValuePath="Tag"
                        Style="{StaticResource UcComboBoxStyle}">

                        <ComboBoxItem Content="Current folder" Tag="{x:Static model:SearchScopeMode.CurrentFolder}" />

                        <ComboBoxItem Content="Current folder and subfolders" Tag="{x:Static model:SearchScopeMode.Recursive}" />

                        <ComboBoxItem Content="Everywhere" Tag="{x:Static model:SearchScopeMode.Everywhere}" />

                    </ComboBox>

                </Grid>


                <!--  File type  -->
                <Grid Grid.Row="1" Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="File type" />

                    <ComboBox
                        Grid.Column="1"
                        Height="28"
                        ItemContainerStyle="{StaticResource UcComboBoxItemStyle}"
                        SelectedValue="{Binding SearchItemType}"
                        SelectedValuePath="Tag"
                        Style="{StaticResource UcComboBoxStyle}">

                        <ComboBoxItem Content="{x:Static model:SearchItemType.All}" Tag="All" />

                        <ComboBoxItem Content="{x:Static model:SearchItemType.Files}" Tag="Files" />

                        <ComboBoxItem Content="{x:Static model:SearchItemType.Folders}" Tag="Folders" />

                    </ComboBox>

                </Grid>


                <!--  Extension  -->
                <Grid Grid.Row="2" Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Extension" />

                    <TextBox
                        Grid.Column="1"
                        Height="28"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        be:InputCaptureBehavior.IsEnabled="True"
                        Foreground="{DynamicResource UcForegroundTertiaryBrush}"
                        Style="{StaticResource UcTextBoxStyle}"
                        Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>


                <!--  Modified  -->
                <Grid Grid.Row="3" Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Modified" />

                    <ComboBox
                        Grid.Column="1"
                        Height="28"
                        ItemContainerStyle="{StaticResource UcComboBoxItemStyle}"
                        SelectedValue="{Binding ModifiedFilter}"
                        SelectedValuePath="Tag"
                        Style="{StaticResource UcComboBoxStyle}">

                        <ComboBoxItem Content="Any time" Tag="{x:Static model:ModifiedFilterMode.Any}" />

                        <ComboBoxItem Content="Today" Tag="{x:Static model:ModifiedFilterMode.Today}" />

                        <ComboBoxItem Content="Yesterday" Tag="{x:Static model:ModifiedFilterMode.Yesterday}" />

                        <ComboBoxItem Content="Last 7 days" Tag="{x:Static model:ModifiedFilterMode.Last7Days}" />

                        <ComboBoxItem Content="Last 30 days" Tag="{x:Static model:ModifiedFilterMode.Last30Days}" />

                        <ComboBoxItem Content="Custom..." Tag="{x:Static model:ModifiedFilterMode.Custom}" />

                    </ComboBox>

                </Grid>


                <!--  Size  -->
                <Grid Grid.Row="4" Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Size" />

                    <ComboBox
                        Grid.Column="1"
                        Height="28"
                        ItemContainerStyle="{StaticResource UcComboBoxItemStyle}"
                        SelectedValue="{Binding SizeFilter}"
                        SelectedValuePath="Tag"
                        Style="{StaticResource UcComboBoxStyle}">

                        <ComboBoxItem Content="Any size" Tag="{x:Static model:SizeFilterMode.Any}" />

                        <ComboBoxItem Content="Empty" Tag="{x:Static model:SizeFilterMode.Empty}" />

                        <ComboBoxItem Content="Small" Tag="{x:Static model:SizeFilterMode.Small}" />

                        <ComboBoxItem Content="Medium" Tag="{x:Static model:SizeFilterMode.Medium}" />

                        <ComboBoxItem Content="Large" Tag="{x:Static model:SizeFilterMode.Large}" />

                        <ComboBoxItem Content="Custom..." Tag="{x:Static model:SizeFilterMode.Custom}" />

                    </ComboBox>

                </Grid>


                <!--  Attributes  -->
                <WrapPanel Grid.Row="5">

                    <CheckBox
                        Margin="0,0,12,4"
                        Content="Hidden"
                        Foreground="{StaticResource UcForegroundSecondaryBrush}"
                        IsChecked="{Binding IncludeHidden}"
                        Style="{StaticResource UcCheckBoxStyle}" />

                    <CheckBox
                        Margin="0,0,12,4"
                        Content="System"
                        Foreground="{StaticResource UcForegroundSecondaryBrush}"
                        IsChecked="{Binding IncludeSystem}"
                        Style="{StaticResource UcCheckBoxStyle}" />

                    <CheckBox
                        Margin="0,0,12,4"
                        Content="Folders"
                        Foreground="{StaticResource UcForegroundSecondaryBrush}"
                        IsChecked="{Binding IncludeFolders}"
                        Style="{StaticResource UcCheckBoxStyle}" />

                </WrapPanel>

            </Grid>

        </Expander>

        <Border
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="10,6"
            Background="{DynamicResource UcSurfaceSecondaryBrush}"
            CornerRadius="5"
            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">

            <StackPanel>

                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource UcForegroundPrimaryBrush}"
                    Text="Searching..." />

                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Text="{Binding SearchProgressText}" />

                <ProgressBar
                    Height="2"
                    Margin="0,0,0,6"
                    IsIndeterminate="{Binding IsSearching}" />

                <Button
                    Command="{Binding CancelSearchCommand}"
                    Content="Cancel"
                    Style="{StaticResource ModernButton}" />

            </StackPanel>

        </Border>

        <!--  Results header  -->
        <Grid Grid.Row="3" Margin="0,0,0,6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                Text="Results" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                Text="{Binding ResultCount}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal">

                <RadioButton
                    Command="{Binding ShowListCommand}"
                    Content="By List"
                    Style="{StaticResource UcRadioButton}" />

                <RadioButton
                    Command="{Binding ShowFoldersCommand}"
                    Content="By Folders"
                    IsChecked="True"
                    Style="{StaticResource UcRadioButton}" />

                <Separator Margin="3,0" VerticalAlignment="Stretch" />

                <Button
                    Height="20"
                    Margin="1,0"
                    Command="{Binding ExpandAllCommand}"
                    Content="Expand"
                    IsEnabled="{Binding IsFolderView}"
                    Style="{StaticResource ModernButton}" />

                <Button
                    Height="20"
                    Margin="3,0"
                    Command="{Binding CollapseAllCommand}"
                    Content="Collapse"
                    IsEnabled="{Binding IsFolderView}"
                    Style="{StaticResource ModernButton}" />

            </StackPanel>

        </Grid>

        <ContentControl Grid.Row="4">
            <control:SearchResultView />
        </ContentControl>
    </Grid>

</UserControl>
