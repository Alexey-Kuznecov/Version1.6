<UserControl
    x:Class="UnityCommander.Modules.LeftSideBars.Content.HomeControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:be="clr-namespace:UnityCommander.Modules.LeftSideBars.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.LeftSideBars.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:widgets="clr-namespace:UnityCommander.WPF.Widget;assembly=UnityCommander.WPF"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Name="WidgetArrowStyle"
            BasedOn="{StaticResource UcButton}"
            TargetType="{x:Type Button}">
            <Setter Property="Content" Value="▼" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Content" Value="▲" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!--<Style
            x:Name="PrimaryActionButton"
            BasedOn="{StaticResource UcButton}"
            TargetType="{x:Type Button}">
            <Setter Property="Content" Value="▼" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Content" Value="▲" />
                </DataTrigger>
            </Style.Triggers>
        </Style>-->
    </UserControl.Resources>
    <ScrollViewer
        be:ScrollViewerWheelBehavior.IsEnabled="True"
        HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center">

            <widgets:WidgetHost ItemsSource="{Binding Widgets}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="9,0,0,8"
                            Background="{DynamicResource UcSurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource UcBorderPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="20" />
                                </Grid.RowDefinitions>

                                <!--  Header  -->
                                <Grid Grid.Row="0" Margin="12,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                                        Text="{Binding Title}" />

                                    <!--  Primary action  -->
                                    <Button
                                        x:Name="PrimaryActionButton"
                                        Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        Margin="4,0,2,0"
                                        Background="Transparent"
                                        Command="{Binding PrimaryAction.Command}"
                                        Content="＋">

                                        <Button.Style>
                                            <Style BasedOn="{StaticResource UcButton}" TargetType="Button">

                                                <Setter Property="Visibility" Value="Visible" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrimaryAction}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>

                                            </Style>
                                        </Button.Style>

                                    </Button>
                                    <!--  More  -->
                                    <Button
                                        x:Name="ActionsButton"
                                        Grid.Column="2"
                                        Width="24"
                                        Height="24"
                                        Margin="2,0,0,0"
                                        Background="Transparent"
                                        Click="ActionsButton_OnClick"
                                        Command="{Binding ShowActionsCommand}"
                                        Content="⋮"
                                        Style="{StaticResource UcButton}" />

                                    <Popup
                                        x:Name="ActionsPopup"
                                        AllowsTransparency="True"
                                        HorizontalOffset="1"
                                        IsOpen="{Binding IsActionsOpen, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=ActionsButton}"
                                        StaysOpen="False"
                                        VerticalOffset="1">

                                        <Border
                                            MinWidth="150"
                                            Padding="4"
                                            Background="{DynamicResource UcSurfaceSecondaryBrush}"
                                            BorderBrush="{DynamicResource UcBorderPrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">

                                            <ItemsControl ItemsSource="{Binding Actions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>

                                                        <Button
                                                            MinWidth="140"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding Command}"
                                                            Content="{Binding Title}"
                                                            IsEnabled="{Binding IsEnabled}"
                                                            Style="{StaticResource UcButton}" />

                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </Border>
                                    </Popup>
                                </Grid>

                                <!--  Widget content  -->
                                <ContentPresenter
                                    x:Name="WidgetContent"
                                    Grid.Row="1"
                                    Content="{Binding View}" />

                                <!--  Collapse  -->
                                <Button
                                    Grid.Row="2"
                                    Width="280"
                                    BorderThickness="0"
                                    Command="{Binding ToggleExpandedCommand}"
                                    FontSize="12"
                                    Foreground="{StaticResource UcForegroundSecondaryBrush}"
                                    Style="{StaticResource UcButton}">

                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="▼" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="▲" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </Button>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                <Setter TargetName="WidgetContent" Property="Height" Value="0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </widgets:WidgetHost>

        </Grid>
    </ScrollViewer>
</UserControl>
