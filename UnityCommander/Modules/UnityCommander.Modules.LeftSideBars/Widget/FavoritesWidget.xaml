<UserControl
    x:Class="UnityCommander.Modules.LeftSideBars.Widget.FavoritesWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons;assembly=UnityCommander.Rendering"
    xmlns:local="clr-namespace:UnityCommander.Modules.LeftSideBars.Widget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ListBox
        Background="{DynamicResource UcSurfaceSecondaryBrush}"
        BorderThickness="0"
        ItemContainerStyle="{StaticResource UcListBoxItemWidgetStyle}"
        ItemsSource="{Binding Favorites}"
        SelectedItem="{Binding SelectedFavorite}"
        Style="{StaticResource UcListBoxTemplate}">

        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel Height="20" Orientation="Horizontal">

                    <icon:IconRender
                        Key="{Binding IconKey}"
                        Width="12"
                        Height="12"
                        Margin="5,0,5,0" />

                    <TextBlock
                        Height="25"
                        Margin="0,5,8,0"
                        Padding="5"
                        VerticalAlignment="Center"
                        Text="{Binding Name}"
                        TextAlignment="Center" />

                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>

    </ListBox>
</UserControl>
