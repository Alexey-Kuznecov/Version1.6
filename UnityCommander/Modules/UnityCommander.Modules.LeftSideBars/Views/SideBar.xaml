<UserControl
    x:Class="UnityCommander.Modules.LeftSideBars.Views.Sidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons;assembly=UnityCommander.Rendering"
    xmlns:local="clr-namespace:UnityCommander.Modules.LeftSideBars.Views"
    xmlns:materialDesigh="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:UnityCommander.Modules.LeftSideBars.ViewModels"
    d:DataContext="{d:DesignInstance vm:SidebarViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Menu">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Width="60"
            Background="{DynamicResource UcAccentSecondaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                Grid.Row="0"
                Background="{DynamicResource UcAccentSecondaryBrush}"
                BorderBrush="{x:Null}"
                ItemContainerStyle="{StaticResource UcListViewItemNormal}"
                ItemsSource="{Binding SidebarItems}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedItem="{Binding CurrentSidebarItem, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Width="45"
                            Height="45"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <icon:IconRender
                                Key="{Binding IconKey}"
                                Width="25"
                                Height="25"
                                Brush="{DynamicResource UcAccentTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <DockPanel Grid.Row="1" Dock="Bottom">

                <ToggleButton
                    x:Name="SettingsButton"
                    Width="60"
                    Height="60"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Style="{StaticResource UcToggleButton}">

                    <icon:IconRender
                        Key="Settings"
                        Width="25"
                        Height="25"
                        Brush="{DynamicResource UcAccentTertiaryBrush}"
                        Stroke="{x:Null}" />

                </ToggleButton>

                <Popup
                    AllowsTransparency="True"
                    HorizontalOffset="10"
                    IsOpen="{Binding IsChecked, ElementName=SettingsButton}"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=SettingsButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False"
                    VerticalOffset="-4">

                    <Border
                        Width="180"
                        Padding="4"
                        Background="{DynamicResource UcSurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource UcBorderPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="5">

                        <ItemsControl>
                            <Menu IsMainMenu="True" Style="{StaticResource UcMenu}">

                                <Menu.Resources>

                                    <Style BasedOn="{StaticResource UcMenuItem}" TargetType="{x:Type MenuItem}" />

                                    <Style BasedOn="{StaticResource UcMenuSeparator}" TargetType="{x:Type Separator}" />

                                </Menu.Resources>

                                <MenuItem Header="Themes">
                                    <MenuItem Header="Dark" />
                                    <MenuItem Header="Light" />
                                    <MenuItem Header="System" />
                                </MenuItem>

                                <MenuItem Header="Icons">
                                    <MenuItem Header="Modern" />
                                    <MenuItem Header="Classic" />
                                </MenuItem>

                                <Separator Style="{DynamicResource UcMenuSeparator}" />

                                <MenuItem Command="{Binding OpenSettingDialogCommand}" Header="Settings" />

                            </Menu>
                        </ItemsControl>
                    </Border>
                </Popup>
            </DockPanel>
        </Grid>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="{Binding SidebarContentWidth, Mode=TwoWay}"
            Background="{DynamicResource UcSurfaceTertiaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ContentControl
                Grid.Row="0"
                Height="25"
                Margin="0,0,10,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{Binding IconHideSidebar}"
                Foreground="{DynamicResource UcForegroundTertiaryBrush}">
                <ContentControl.Template>
                    <DynamicResource ResourceKey="CustomButtonTemplate" />
                </ContentControl.Template>
                <ContentControl.Style>
                    <DynamicResource ResourceKey="CustomButtonStyles" />
                </ContentControl.Style>
                <ContentControl.InputBindings>
                    <MouseBinding Command="{Binding HideSidebarCommand}" Gesture="LeftClick" />
                </ContentControl.InputBindings>
                <ContentControl.ToolTip>
                    <ToolTip Content="Collapse sidebar" />
                </ContentControl.ToolTip>
            </ContentControl>
            <Border Grid.Row="1">
                <ContentControl Content="{Binding SidebarContent}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
