<UserControl
    x:Class="UnityCommander.Modules.LeftSideBars.Controls.SearchResultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnityCommander.Modules.LeftSideBars.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:result="clr-namespace:UnityCommander.Modules.LeftSideBars.Search.Result"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style
            x:Key="UcSearchResualtStyle"
            BasedOn="{StaticResource UcListViewItemNormal}"
            TargetType="{x:Type ListViewItem}">
            <Setter Property="Height" Value="60" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <ContentControl Content="{Binding Results}">
            <ContentControl.Resources>

                <!--  Flat  -->
                <DataTemplate DataType="{x:Type result:FlatSearchResultView}">
                    <ListView
                        ItemContainerStyle="{StaticResource UcSearchResualtStyle}"
                        ItemsSource="{Binding Items}"
                        Style="{StaticResource UcListBoxTemplate}">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource UcForegroundPrimaryBrush}"
                                        Text="{Binding Item.Name}"
                                        TextTrimming="CharacterEllipsis" />-->

                                    <local:SearchHighlightText
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource UcForegroundPrimaryBrush}"
                                        Query="{Binding SearchQuery}"
                                        Text="{Binding Item.Name}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                                        Text="{Binding DisplaySize}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        FontSize="11"
                                        Foreground="{DynamicResource UcForegroundPrimaryBrush}"
                                        Text="{Binding Path}"
                                        TextTrimming="CharacterEllipsis" />

                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DataTemplate>


                <!--  Folders  -->
                <DataTemplate DataType="{x:Type result:FolderSearchResultView}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Folders}" />

                    </ScrollViewer>
                </DataTemplate>


                <!--  Tree  -->
                <DataTemplate DataType="{x:Type result:TreeSearchResultView}">
                    <TreeView ItemsSource="{Binding Roots}" />
                </DataTemplate>

            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</UserControl>
