<UserControl
    x:Class="UnityCommander.Modules.BottomPanel.Views.BottomPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
    xmlns:core="clr-namespace:UnityCommander.Core;assembly=UnityCommander.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputBinding="clr-namespace:UnityCommander.WPF.Behaviors;assembly=UnityCommander.WPF"
    xmlns:local="clr-namespace:UnityCommander.Modules.BottomPanel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:xcad="http://schemas.xceed.com/wpf/xaml/avalondock"
    d:DesignHeight="250"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid inputBinding:KeyboardBinding.Scope="Console,MainWindow">

        <DockingManager
            x:Name="DockManager"
            Grid.Row="1"
            AllowMixedOrientation="True"
            AutoWindowSizeWhenOpened="True"
            IsVirtualizingAnchorable="True"
            IsVirtualizingDocument="True">
            <LayoutRoot>

                <LayoutPanel Orientation="Horizontal">

                    <LayoutAnchorablePaneGroup>
                        <LayoutAnchorablePane>

                            <LayoutAnchorable
                                x:Name="ConsoleTool"
                                Title="Console"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Console">

                                <ContentControl Grid.Column="0" prism:RegionManager.RegionName="{x:Static core:RegionNames.LeftConsoleRegion}" />

                            </LayoutAnchorable>

                        </LayoutAnchorablePane>
                    </LayoutAnchorablePaneGroup>

                    <LayoutAnchorablePaneGroup>
                        <LayoutAnchorablePane>

                            <LayoutAnchorable
                                x:Name="ConsoleRight"
                                Title="Console"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Console">
                                <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.RightConsoleRegion}" />


                            </LayoutAnchorable>

                            <LayoutAnchorable
                                x:Name="LoggerTool"
                                Title="Logger"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Logger">

                                <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.LogTabRegion}" />
                            </LayoutAnchorable>

                        </LayoutAnchorablePane>
                    </LayoutAnchorablePaneGroup>

                </LayoutPanel>

            </LayoutRoot>
        </DockingManager>

        <!--  Правая вкладка: предпросмотр файлов  -->
        <!--<Border
            Grid.Column="1"
            Margin="10,0,0,0"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1,0,0,0">
        -->
        <!--<ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.LogTabRegion}" />-->

        <!--<ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.PreviewRegion}" />-->
        <!--
        </Border>-->
    </Grid>
</UserControl>