<UserControl
    x:Class="UnityCommander.Modules.BottomPanel.Views.PreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="250"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!--<RowDefinition Height="Auto" />-->
            <RowDefinition Height="*" />
            <!--<RowDefinition Height="Auto" />-->
        </Grid.RowDefinitions>

        <!--  File information  -->
        <!--<Border Grid.Row="0" Padding="8">

            <DockPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Text="{Binding FileName}" />

                <TextBlock
                    Margin="10,0,0,0"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Opacity="0.65"
                    Text="{Binding Kind}" />

                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Opacity="0.65"
                    Text="{Binding Metadata.ContentType}" />
            </DockPanel>

        </Border>-->

        <!--  Presenter content  -->
        <Grid>

            <ContentControl Content="{Binding PresenterContent}" />

            <!--  Loading  -->
            <Border Background="#80000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="Loading preview..." />
            </Border>

        </Grid>

        <!--  Status  -->
        <!--<DockPanel Grid.Row="2" Margin="8">

            <TextBlock Foreground="Tomato" Text="{Binding ErrorMessage}" />

            <TextBlock Margin="8,0,0,0" Text="Unsupported format">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Foreground" Value="{DynamicResource UcForegroundSecondaryBrush}" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </DockPanel>-->

    </Grid>

</UserControl>