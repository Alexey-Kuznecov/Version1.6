<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:IconBrowser.Converters">

    <!--<Style x:Key="CollectionMenuDragDropStyle" TargetType="TextBlock">
        <Setter Property="Background" Value="#F0F0F0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>-->

    <DataTemplate x:Key="ComboBoxItemTemplate">
        <Grid
            Height="16"
            Margin="2"
            VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>

            <!--  HEX  -->
            <TextBlock
                Margin="4,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource UcForegroundPrimaryBrush}"
                Text="{Binding}" />

            <!--  Цвет  -->
            <Border
                Grid.Column="1"
                Width="16"
                Height="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{Binding}"
                BorderBrush="#555759"
                BorderThickness="1"
                CornerRadius="3" />

        </Grid>
    </DataTemplate>

    <!--  СТИЛИ ДЛЯ ИКОНОК РЕДАКТОРА ИКОНОК  -->

    <Style x:Key="IconStylesEditor" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{Binding SelectedItem.Content, ElementName=ComboBox}" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource Self}, Path=Height}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource UcSurfacePrimaryBrush}" />
    </Style>

    <ControlTemplate x:Key="IconTemplateEditor" TargetType="ContentControl">
        <ControlTemplate.Resources>
            <converters:ContentConverter x:Key="ContentConverter" />
            <converters:ScaleConverter x:Key="ScaleConverter" />
        </ControlTemplate.Resources>
        <Grid x:Name="grid">
            <Path
                x:Name="rect"
                Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"
                Stretch="Uniform"
                StrokeThickness="0">
                <Path.Data>
                    <RectangleGeometry Rect="0,0,50,50" />
                </Path.Data>
            </Path>
            <Path
                x:Name="shape"
                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Width}"
                Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Height}"
                Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource ContentConverter}}"
                Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                Stretch="Uniform" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="rect" Property="Fill" Value="{Binding}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  СТИЛИ И ШАБЛОНЫ ДЛЯ ЦВЕТНЫХ ИКОНОК  -->

    <Style x:Key="IconStylesEditorColor" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource Self}, Path=Height}" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{Binding Brush}" />
    </Style>

    <ControlTemplate x:Key="IconTemplateEditorColor" TargetType="ContentControl">
        <ControlTemplate.Resources>
            <!--<converters:ContentConverter x:Key="ContentConverter" />-->
        </ControlTemplate.Resources>
        <Grid>
            <Path x:Name="rect" Stretch="Uniform">
                <Path.Data>
                    <RectangleGeometry Rect="0,0,50,50" />
                </Path.Data>
            </Path>
            <Path
                x:Name="icon"
                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Width}"
                Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Height}"
                Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"
                Stretch="Uniform">
                <Path.Data>
                    <RectangleGeometry Rect="0,0,40,40" />
                </Path.Data>
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="rect" Property="Fill" Value="{DynamicResource UcHoverTertiaryBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>