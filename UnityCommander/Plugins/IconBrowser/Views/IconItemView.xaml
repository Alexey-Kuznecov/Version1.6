<UserControl
    x:Class="IconBrowser.Views.IconItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IconBrowser"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:IconBrowser.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Install" />
                <MenuItem Header="Move to" />
                <MenuItem Command="{Binding RenameCommand}" Header="Rename" />
                <MenuItem Command="{Binding RemoveCommand}" Header="Delete" />
            </ContextMenu>
        </Grid.ContextMenu>

        <ContentControl
            Width="{Binding Scale}"
            Height="{Binding Scale}"
            Content="{Binding Brush}"
            Style="{Binding Style}"
            Tag="{Binding Icon.Id}"
            Template="{Binding Template}">

            <ContentControl.ToolTip>
                <ToolTip>
                    <StackPanel>
                        <ContentControl
                            Content="{Binding Brush}"
                            Style="{Binding Style}"
                            Tag="{Binding Icon.Id}"
                            Template="{Binding Template}" />
                        <TextBlock Text="{Binding Icon.Name}" />
                    </StackPanel>
                </ToolTip>
            </ContentControl.ToolTip>

            <!--<ContentControl.InputBindings>
                <MouseBinding Command="{Binding SelectPackCommand}" Gesture="LeftClick" />
            </ContentControl.InputBindings>-->

        </ContentControl>
    </Grid>
</UserControl>
