<UserControl
    x:Class="IconBrowser.Views.IconItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:IconBrowser.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IconBrowser.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:IconBrowser.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <converter:IconViewTemplateConverter x:Key="IconViewTemplateConverter" />



        <ControlTemplate x:Key="ListTemplate">
            <Grid>

                <!--  вся разметка List  -->

                <ContentControl
                    Width="{Binding Scale}"
                    Height="{Binding Scale}"
                    Content="{Binding Brush}"
                    Style="{Binding Style}"
                    Tag="{Binding Icon.Id}"
                    Template="{Binding Template}" />

                <TextBlock Margin="8,0,0,0" Text="{Binding Icon.Name}" />

            </Grid>
        </ControlTemplate>


        <ControlTemplate x:Key="TileTemplate">
            <Grid>

                <ContentControl
                    Width="{Binding Scale}"
                    Height="{Binding Scale}"
                    Content="{Binding Brush}"
                    Style="{Binding Style}"
                    Tag="{Binding Icon.Id}"
                    Template="{Binding Template}">

                    <ContentControl.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <ContentControl
                                    Content="{Binding Brush}"
                                    Style="{Binding Style}"
                                    Tag="{Binding Icon.Id}"
                                    Template="{Binding Template}" />
                                <TextBlock Text="{Binding Icon.Name}" />
                            </StackPanel>
                        </ToolTip>
                    </ContentControl.ToolTip>

                    <!--<ContentControl.InputBindings>
         <MouseBinding Command="{Binding SelectPackCommand}" Gesture="LeftClick" />
     </ContentControl.InputBindings>-->

                </ContentControl>

            </Grid>
        </ControlTemplate>


        <ControlTemplate x:Key="CardTemplate">
            <Grid>

                <!--  вся разметка Card  -->

                <ContentControl
                    Width="{Binding Scale}"
                    Height="{Binding Scale}"
                    Content="{Binding Brush}"
                    Style="{Binding Style}"
                    Tag="{Binding Icon.Id}"
                    Template="{Binding Template}" />

                <TextBlock Text="{Binding Icon.Name}" />

            </Grid>
        </ControlTemplate>


    </UserControl.Resources>

    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Install" />
                <MenuItem Header="Move to" />
                <MenuItem Command="{Binding RenameCommand}" Header="Rename" />
                <MenuItem Command="{Binding RemoveCommand}" Header="Delete" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!--<ContentControl Content="{Binding Brush}" Template="{Binding RelativeSource={RelativeSource AncestorType=local:IconMakerView}, Path=DataContext.ViewMode, Converter={StaticResource IconViewTemplateConverter}}" />-->
        <ContentControl
            Width="{Binding Scale}"
            Height="{Binding Scale}"
            Content="{Binding Brush}"
            Style="{Binding Style}"
            Tag="{Binding Icon.Id}"
            Template="{Binding Template}">

            <ContentControl.ToolTip>
                <ToolTip
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">

                    <Border
                        MinWidth="90"
                        MinHeight="80"
                        Padding="10"
                        Background="{DynamicResource UcSurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource UcBorderTertiaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!--  Иконка  -->
                            <ContentControl
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Content="{Binding Brush}"
                                Style="{Binding Style}"
                                Tag="{Binding Icon.Id}"
                                Template="{Binding Template}" />

                            <!--  Название  -->
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource UcForegroundPrimaryBrush}"
                                Text="{Binding Icon.Name}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ToolTip>
            </ContentControl.ToolTip>

            <ContentControl.InputBindings>
                <MouseBinding Command="{Binding SelectPackCommand}" Gesture="LeftClick" />
            </ContentControl.InputBindings>

        </ContentControl>
    </Grid>

</UserControl>
