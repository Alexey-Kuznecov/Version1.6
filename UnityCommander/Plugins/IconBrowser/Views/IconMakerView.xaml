<UserControl
    x:Class="IconBrowser.Views.IconMakerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IconBrowser.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:IconBrowser.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--<DataTemplate x:Key="ComboBoxItemTemplate">

            <StackPanel Orientation="Horizontal">

                <Border
                    Width="14"
                    Height="14"
                    Margin="0,0,8,0"
                    Background="{Binding Brush}"
                    CornerRadius="3" />

                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />

            </StackPanel>

        </DataTemplate>-->
    </UserControl.Resources>


    <Grid Background="{DynamicResource UcSurfaceSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <Menu
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource UcSurfaceTertiaryBrush}">
            <MenuItem
                FontSize="12"
                Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                Header="File">
                <MenuItem
                    Command="{Binding AddNewIconCommand}"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Header="Open" />
                <MenuItem
                    Command="{Binding ImportIconCommand}"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Header="Импорт Svg" />
                <MenuItem
                    Command="{Binding SaveCommand}"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Header="Сохранить" />
                <Separator Style="{StaticResource UcMenuSeparator}" />
                <MenuItem
                    Command="{Binding ShutdownCommand}"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Header="Close" />
            </MenuItem>
            <MenuItem
                FontSize="12"
                Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                Header="View">
                <MenuItem
                    Command="{Binding SetViewCommand}"
                    CommandParameter="{x:Static models:IconViewMode.List}"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Header="Lists" />

                <MenuItem
                    Command="{Binding SetViewCommand}"
                    CommandParameter="{x:Static models:IconViewMode.Tile}"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Header="Tiles" />

                <MenuItem
                    Command="{Binding SetViewCommand}"
                    CommandParameter="{x:Static models:IconViewMode.Card}"
                    Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                    Header="Cards" />
            </MenuItem>
            <MenuItem
                FontSize="12"
                Foreground="{DynamicResource UcForegroundSecondaryBrush}"
                Header="Tools">
                <MenuItem Foreground="{DynamicResource UcForegroundSecondaryBrush}" Header="Resource" />
                <MenuItem Foreground="{DynamicResource UcForegroundSecondaryBrush}" Header="Palette" />
                <MenuItem Foreground="{DynamicResource UcForegroundSecondaryBrush}" Header="Formatter" />
                <MenuItem Foreground="{DynamicResource UcForegroundSecondaryBrush}" Header="Plugins" />
            </MenuItem>
        </Menu>

        <TextBox
            Grid.Row="1"
            Grid.Column="0"
            Width="210"
            Height="35"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AllowDrop="True"
            FontSize="16"
            FontStyle="Italic"
            Style="{DynamicResource UcTextBoxStyle}"
            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <local:IconPackListView
            Grid.Row="2"
            Grid.Column="0"
            Margin="5"
            DataContext="{Binding IconPackList}" />


        <ScrollViewer
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="5"
            Background="{DynamicResource UcSurfaceSecondaryBrush}"
            Style="{DynamicResource UcScrollViewerStyle}"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl
                ItemsSource="{Binding VisibleIcons}"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:IconItemView ViewMode="{Binding ViewMode, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>
        </ScrollViewer>
        <Border
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Padding="10"
            Background="{DynamicResource UcSurfaceTertiaryBrush}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Width="160"
                    Background="{DynamicResource UcSurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource UcBorderPrimaryBrush}"
                    Foreground="{StaticResource UcForegroundSecondaryBrush}"
                    ItemContainerStyle="{StaticResource UcComboBoxItemStyle}"
                    ItemTemplate="{StaticResource ComboBoxItemTemplate}"
                    ItemsSource="{Binding AvailableColors}"
                    SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                    Style="{DynamicResource UcComboBoxStyle}" />

                <CheckBox
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    Content="Monochrome"
                    Foreground="{StaticResource UcForegroundSecondaryBrush}"
                    IsChecked="{Binding CurrentTheme.IsMonochrome, Mode=TwoWay}"
                    Style="{DynamicResource UcCheckBoxStyle}" />

                <Slider
                    Grid.Column="2"
                    Width="180"
                    Margin="15,0,0,0"
                    Maximum="256"
                    Minimum="12"
                    Style="{StaticResource UcSliderStyle}"
                    Value="{Binding CurrentTheme.Scale}" />

                <Button
                    Grid.Column="4"
                    Width="120"
                    Margin="0,3,10,0"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveThemeCommand}"
                    Content="Save Theme"
                    Style="{StaticResource ModernButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
