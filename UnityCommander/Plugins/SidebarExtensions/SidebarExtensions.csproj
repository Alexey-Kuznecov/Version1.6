<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputPath>..\..\plugins\</OutputPath>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<OutputPath Condition="'$(TargetFramework)' == 'net9.0-windows;net10.0-windows'">..\..\..\UnityCommander\UnityCommander\bin\Debug\net9.0-windows;net10.0-windows\plugins\MultiColumns</OutputPath>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\..\..\PluginSystem\PluginSystem.Abstractions\PluginSystem.Abstractions.csproj" />
		<ProjectReference Include="..\..\..\..\PluginSystem\PluginSystem.Runtime\PluginSystem.Runtime.csproj" />
		<ProjectReference Include="..\..\UnityCommander.Abstractions\UnityCommander.Abstractions.csproj" />
		<ProjectReference Include="..\..\UnityCommander.Common\UnityCommander.Common.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Microsoft.Extensions.DependencyInjection">
			<HintPath>..\..\UnityCommander\bin\Debug\netcoreapp3.1\Microsoft.Extensions.DependencyInjection.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
			<HintPath>..\..\UnityCommander\bin\Debug\netcoreapp3.1\Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy /y /d &quot;$(TargetPath)&quot; &quot;$(SolutionDir)\UnityCommander\UnityCommander\bin\Debug\net10.0-windows\plugins\SidebarExtensions\&quot;" />
	</Target>
</Project>