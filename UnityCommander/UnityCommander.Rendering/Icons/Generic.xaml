<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons">

    <Style TargetType="{x:Type icon:IconRender}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icon:IconRender}">
                    <Path
                        Data="{TemplateBinding Data}"
                        Fill="{TemplateBinding Brush}"
                        Stretch="Uniform" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Brush" Value="{Binding DefaultBrush, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Brush" Value="Red" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconHostStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#20000000" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>