<UserControl
    x:Class="UnityCommander.Preview.Wpf.Views.FolderPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:UnityCommander.Rendering.Icons;assembly=UnityCommander.Rendering"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="700"
    mc:Ignorable="d">


    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Folder thumbnails  -->
        <ItemsControl
            Grid.Column="0"
            Width="196"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ItemsSource="{Binding Thumbnails}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="96"
                        Height="96"
                        Margin="1"
                        ClipToBounds="True">

                        <Image Source="{Binding Converter={StaticResource ThumbnailImageConverter}}" Stretch="UniformToFill" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Folder information  -->
        <StackPanel Grid.Column="1" Margin="8,0,0,0">

            <TextBlock
                Margin="0,0,0,6"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Margin="0,0,0,16"
                Foreground="White"
                Opacity="0.65"
                Text="{Binding Path}"
                TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,3"
                    Foreground="White"
                    Opacity="0.65"
                    Text="Files" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,3"
                    Foreground="White"
                    Text="{Binding FileCount, StringFormat={}{0:N0}}" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,3"
                    Foreground="White"
                    Opacity="0.65"
                    Text="Folders" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,3"
                    Foreground="White"
                    Text="{Binding DirectoryCount, StringFormat={}{0:N0}}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,3"
                    Foreground="White"
                    Opacity="0.65"
                    Text="Total size" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,3"
                    Foreground="White"
                    Text="{Binding FormattedSize}" />

                <TextBlock
                    Grid.Row="3"
                    Margin="0,3"
                    Foreground="White"
                    Opacity="0.65"
                    Text="Created" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,3"
                    Foreground="White"
                    Text="{Binding CreationTime, StringFormat={}{0:G}}" />

                <TextBlock
                    Grid.Row="4"
                    Margin="0,3"
                    Foreground="White"
                    Opacity="0.65"
                    Text="Modified" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,3"
                    Foreground="White"
                    Text="{Binding LastModified, StringFormat={}{0:G}}" />
            </Grid>
        </StackPanel>
    </Grid>

</UserControl>
