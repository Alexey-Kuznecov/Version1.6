<UserControl
    x:Class="UnityCommander.Preview.Wpf.Views.VideoPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">

    <Grid Background="Black">

        <vlc:VideoView MediaPlayer="{Binding MediaPlayer}">

            <!--  Весь overlay должен оставаться внутри VideoView  -->


            <Grid x:Name="VideoSurface" Background="Transparent">

                <Border
                    x:Name="ControlPanel"
                    Padding="8,5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="#CC202020"
                    CornerRadius="0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Play / Pause  -->
                        <Button
                            Grid.Column="0"
                            Width="36"
                            Margin="0,0,8,0"
                            Command="{Binding TogglePlayPauseCommand}"
                            Content="{Binding PlayPauseIcon}"
                            Style="{StaticResource ModernButton}"
                            ToolTip="Play / Pause" />

                        <!--  Timeline  -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="White"
                                Text="{Binding PositionText}" />

                            <Slider
                                Grid.Column="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                Maximum="{Binding Duration}"
                                Minimum="0"
                                PreviewMouseDown="Timeline_PreviewMouseDown"
                                PreviewMouseUp="Timeline_PreviewMouseUp"
                                Style="{StaticResource UcSliderTimelineStyle}"
                                Value="{Binding Position, Mode=TwoWay}" />

                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="White"
                                Text="{Binding DurationText}" />
                        </Grid>

                        <!--  Volume  -->
                        <ToggleButton
                            x:Name="VolumeButton"
                            Grid.Column="2"
                            Width="36"
                            Margin="8,0,0,0"
                            Content="🔊"
                            Style="{StaticResource UcToggleButton}"
                            ToolTip="Volume" />

                        <Popup
                            IsOpen="{Binding IsChecked, ElementName=VolumeButton}"
                            Placement="Top"
                            PlacementTarget="{Binding ElementName=VolumeButton}"
                            StaysOpen="False">

                            <Border
                                Width="58"
                                Padding="8"
                                Background="#F0202020"
                                BorderBrush="#505050"
                                BorderThickness="1"
                                CornerRadius="4">

                                <StackPanel HorizontalAlignment="Center">

                                    <Slider
                                        Width="24"
                                        Height="110"
                                        IsMoveToPointEnabled="True"
                                        Maximum="100"
                                        Minimum="0"
                                        Orientation="Vertical"
                                        Style="{StaticResource UcSliderVolumeStyle}"
                                        Value="{Binding Volume, Mode=TwoWay}" />

                                    <Button
                                        Width="40"
                                        Margin="0,8,0,0"
                                        Command="{Binding ToggleMuteCommand}"
                                        Content="Mute"
                                        FontSize="10"
                                        Style="{StaticResource ModernButton}"
                                        ToolTip="Mute / Unmute" />

                                </StackPanel>
                            </Border>
                        </Popup>

                        <!--  Settings  -->
                        <ToggleButton
                            x:Name="SettingsButton"
                            Grid.Column="3"
                            Width="36"
                            Margin="4,0,0,0"
                            Content="⚙"
                            Style="{StaticResource UcToggleButton}"
                            ToolTip="Playback settings" />

                        <Popup
                            IsOpen="{Binding IsChecked, ElementName=SettingsButton}"
                            Placement="Top"
                            PlacementTarget="{Binding ElementName=SettingsButton}"
                            StaysOpen="False">

                            <Border
                                MinWidth="170"
                                Padding="12"
                                Background="#F0202020"
                                BorderBrush="#505050"
                                BorderThickness="1"
                                CornerRadius="4">

                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Playback settings" />

                                    <CheckBox
                                        Margin="0,4"
                                        Content="Auto Play"
                                        Foreground="White"
                                        IsChecked="{Binding IsAutoPlayEnabled}" />

                                    <CheckBox
                                        Margin="0,4"
                                        Content="Repeat"
                                        Foreground="White"
                                        IsChecked="{Binding IsRepeatEnabled}" />

                                </StackPanel>
                            </Border>
                        </Popup>

                    </Grid>
                </Border>

            </Grid>
        </vlc:VideoView>

    </Grid>
</UserControl>
