<UserControl x:Class="UnityCommander.Diagnostics.Workbench.Views.Reporting.ReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14,12,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DIAGNOSTIC SOURCES" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SourceCount}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RESULTS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding ResultCount}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WARNINGS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding WarningCount}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Diagnostic mode"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding DiagnosticModes}"
                      SelectedItem="{Binding DiagnosticMode}" />
            <TextBlock Grid.Column="2"
                       Text="DiagnosticPipeline · available sources and their latest results"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       FontSize="11" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Diagnostic sources" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Sources}"
                             SelectedItem="{Binding SelectedSource}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="9,10" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Category}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0"
                            Padding="13,0">
                        <TextBlock Text="Diagnostic results" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedResult}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.1*" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="85" />
                            <DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="Result details" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedResult.Name}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedResult.Status}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0,4,0,13" />
                    <TextBlock Text="SUMMARY" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedResult.Summary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />
                    <TextBlock Text="DETAILS" Style="{StaticResource MetricLabel}" />
                    <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10">
                        <TextBlock Text="{Binding SelectedResult.Details}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
