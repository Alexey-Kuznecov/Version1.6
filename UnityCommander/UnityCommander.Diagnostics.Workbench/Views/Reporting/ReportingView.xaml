<UserControl
    x:Class="UnityCommander.Diagnostics.Workbench.Views.Reporting.ReportingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14,12,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid
            Grid.Row="0"
            Margin="0,0,0,12"
            Columns="3">
            <Border Margin="0,0,8,0" Style="{StaticResource PanelBorder}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="DIAGNOSTIC SOURCES" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding SourceCount}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Style="{StaticResource PanelBorder}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="RESULTS" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding ResultCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="WARNINGS" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding WarningCount}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MutedTextBrush}"
                Text="Diagnostic mode" />

            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding DiagnosticModes}"
                SelectedItem="{Binding DiagnosticMode}" />

            <ToggleButton
                x:Name="ComponentFilterButton"
                Grid.Column="2"
                Margin="10,0,0,0"
                Padding="12,5"
                VerticalAlignment="Center"
                Content="Components ▼"
                IsChecked="{Binding IsComponentFilterOpen, Mode=TwoWay}" />

            <Popup
                IsOpen="{Binding IsComponentFilterOpen, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=ComponentFilterButton}"
                StaysOpen="False">

                <Border
                    Width="250"
                    MaxHeight="380"
                    Margin="0,5,0,0"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="Diagnostic components" />

                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding ComponentFilterSummary}"
                                IsChecked="{Binding AllComponentsSelected, Mode=TwoWay}" />

                            <Separator Margin="0,0,0,8" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding ComponentFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,4"
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>

            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource MutedTextBrush}"
                Text="DiagnosticPipeline · available sources and their latest results" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12"
                Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Style="{StaticResource SectionTitle}"
                        Text="Diagnostic sources" />
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Sources}"
                        SelectedItem="{Binding SelectedSource}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="9,10" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="ItemBorder"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="10"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        Text="{Binding Category}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="0"
                Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Padding="13,0"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Diagnostic results" />
                    </Border>
                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedResult}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="1.1*"
                                Binding="{Binding Name}"
                                Header="NAME" />
                            <DataGridTextColumn
                                Width="85"
                                Binding="{Binding Status}"
                                Header="STATUS" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Summary}"
                                Header="SUMMARY" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="Result details" />

                            <Button
                                Grid.Column="1"
                                Padding="10,5"
                                Command="{Binding CopyJsonCommand}"
                                Content="Copy JSON" />
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Result details" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedResult.Name}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,13"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WarningBrush}"
                            Text="{Binding SelectedResult.Status}" />
                        <TextBlock Style="{StaticResource MetricLabel}" Text="SUMMARY" />
                        <TextBlock
                            Margin="0,0,0,14"
                            Text="{Binding SelectedResult.Summary}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MetricLabel}" Text="DETAILS" />

                        <Border
                            Padding="10"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding SelectedResult.Details}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
